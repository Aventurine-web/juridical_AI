# ============================================================
# Setup: copy this file to .env, then paste your keys below.
#   cp .env.example .env
# (.env is gitignored — your real keys never get committed.)
# ============================================================

# REQUIRED — Gemini API key. Powers the ADK agent.
# Get a FREE key in ~30s at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Tells ADK to use the Gemini API (AI Studio) rather than Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# REQUIRED — Tavily API key. Used for live search of official Swedish
# sources (Skatteverket, Bolagsverket, verksamt.se, …).
# Get a FREE key at https://app.tavily.com
TAVILY_API_KEY=

# OPTIONAL — Jina Reader API key. Lets the agent open & read the FULL text of
# official PDFs/pages found in search (complements Tavily snippets). Works
# WITHOUT a key on the free tier; a key raises rate limits.
# Get one at https://jina.ai/reader
JINA_API_KEY=
